# Staging environment.
# Same hosts as dev (these demo sites have no separate staging deployment), but
# runs as `problem_user` — a Sauce Demo account that deliberately renders broken
# images and mis-wired form fields. This keeps `npm run test:staging` meaningfully
# different from `test:dev` instead of being a duplicate config.

BASE_URL_THE_INTERNET=https://the-internet.herokuapp.com
BASE_URL_SAUCE_DEMO=https://www.saucedemo.com
BASE_URL_AUTOMATION_EXERCISE=https://automationexercise.com
BASE_URL_DEMOQA=https://demoqa.com

SAUCE_USERNAME=problem_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_OUT_USERNAME=locked_out_user
